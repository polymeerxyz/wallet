{
  "extends": "@polymeer/config/typescript/tsconfig.base.json",
  "include": ["src", "tests", "vitest.config.ts"],
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "declarationDir": "dist",
    "emitDeclarationOnly": true,
    "noEmit": false,
    "skipLibCheck": true
  }
}
